{
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": null,
    "CallbackPath": "/signin-oidc"
  },
  "N24DataRelay": {
    "Branding": {
      "CompanyName": "Network24",
      "ProductName": "N24 Data Relay",
      "SiteName": "Your Site Name",
      "SupportEmail": "help@network24.tv",
      "LogoPath": null,
      "DmzSideName": "DMZ",
      "ScadaSideName": "SCADA",
      "Theme": {
        "PrimaryColor": "#0066cc",
        "SecondaryColor": "#003366",
        "AccentColor": "#FF6600"
      }
    },
    "Paths": {
      "UploadDirectory": "/var/lib/n24-data-relay/uploads",
      "TransferDirectory": "/var/lib/n24-data-relay/uploads/transfer",
      "LogDirectory": "/var/log/n24-data-relay",
      "ConfigDirectory": "/etc/n24-data-relay",
      "TempDirectory": "/var/lib/n24-data-relay/temp"
    },
    "Logging": {
      "RetentionDays": 30,
      "MaxFileSizeMB": 100,
      "EnableEventLog": false,
      "EnableConsole": true
    },
    "Service": {
      "Enabled": true,
      "ServiceName": "n24-data-relay",
      "DisplayName": "N24 Data Relay Watcher",
      "Description": "Automated file transfer from DMZ to SCADA networks",
      "WatchDirectory": "/var/lib/n24-data-relay/uploads/transfer",
      "TransferMethod": "ssh",
      "RetryAttempts": 3,
      "RetryDelaySeconds": 30,
      "RetryBackoffMultiplier": 2,
      "MaxConcurrentTransfers": 5,
      "FileFilter": "*.*",
      "DeleteAfterTransfer": true,
      "ArchiveAfterTransfer": false,
      "ArchiveDirectory": "/var/lib/n24-data-relay/archive",
      "VerifyTransfer": true,
      "FileStabilitySeconds": 5,
      "ProcessingIntervalSeconds": 10,
      "MaxQueueSize": 10000,
      "IncludeSubdirectories": true
    },
    "WebPortal": {
      "Enabled": true,
      "Authentication": {
        "EnableEntraId": false,
        "EnableLocalAccounts": true,
        "ConnectionString": "Data Source=/var/lib/n24-data-relay/n24datarelay.db",
        "RequireEmailConfirmation": false,
        "RequireApproval": true,
        "PasswordExpiryDays": 90,
        "PasswordExpiryWarningDays": 14,
        "ApiKey": ""
      },
      "MaxFileSizeBytes": 10737418240,
      "MaxConcurrentUploads": 10,
      "BlockedFileExtensions": [
        ".exe",
        ".dll",
        ".bat",
        ".cmd",
        ".ps1",
        ".vbs",
        ".js"
      ],
      "EnableUploadToTransfer": true,
      "Kestrel": {
        "HttpPort": 8080,
        "HttpsPort": 8443,
        "EnableHttps": false,
        "CertificatePath": null,
        "CertificatePassword": null
      }
    },
    "Transfer": {
      "Ssh": {
        "Host": "",
        "Port": 22,
        "Username": "",
        "AuthMethod": "PublicKey",
        "PrivateKeyPath": null,
        "PrivateKeyPassphrase": null,
        "PasswordEncrypted": null,
        "DestinationPath": "",
        "RemoteServerType": "Linux",
        "CreateDestinationDirectory": true,
        "PreserveTimestamps": true,
        "ConnectionTimeout": 30,
        "OperationTimeout": 300,
        "TransferTimeout": 300,
        "KeepAliveInterval": 30,
        "Compression": true,
        "StrictHostKeyChecking": true,
        "KnownHostFingerprint": null
      },
      "Smb": {
        "Server": "",
        "SharePath": "",
        "UseCredentials": false,
        "Username": null,
        "PasswordEncrypted": null,
        "Domain": null,
        "Timeout": 300
      }
    },
    "Smtp": {
      "Enabled": false,
      "Host": "",
      "Port": 587,
      "Security": "StartTls",
      "Username": "",
      "Password": "",
      "FromAddress": "",
      "FromName": "N24 Data Relay",
      "TimeoutSeconds": 30
    }
  }
}
