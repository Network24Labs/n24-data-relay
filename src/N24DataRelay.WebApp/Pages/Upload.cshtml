@page
@model UploadModel
@{
    ViewData["Title"] = "Upload";
}

<div class="card">
    <div class="card-header">
        <h4 class="mb-0">File Upload</h4>
        <small class="text-white-50">Signed in as @(User.Identity?.Name ?? "Unknown")</small>
    </div>
    <div class="card-body">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <label class="form-label">Select files</label>
                <input type="file" name="Files" class="form-control" multiple />
                <div class="form-text">Max size per file: @Model.MaxFileSizeBytesDisplay. Blocked extensions: @Model.BlockedExtensionsDisplay</div>
            </div>
            @if (Model.ShowTransferOption)
            {
                <div class="mb-3 form-check">
                    <input asp-for="RequiresTransfer" class="form-check-input" />
                    <label asp-for="RequiresTransfer" class="form-check-label">Send to transfer (SCADA)</label>
                </div>
            }
            <div class="mb-3">
                <label asp-for="Notes" class="form-label">Notes (optional)</label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Upload</button>
        </form>
    </div>
</div>
