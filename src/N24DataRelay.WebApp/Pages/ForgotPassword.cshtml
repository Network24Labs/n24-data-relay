@page
@model N24DataRelay.WebApp.Pages.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <i class="fa-solid fa-key fa-2x text-primary mb-2"></i>
                    <h4 class="mb-0">Reset Password</h4>
                </div>

                @if (Model.Submitted)
                {
                    <div class="alert alert-info">
                        <i class="fa-solid fa-circle-info me-2"></i>
                        <strong>Request received.</strong>
                        If an approved account exists for that email address, a reset link has been generated.
                    </div>
                    <div class="alert alert-warning small">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>
                        <strong>Email delivery is not yet configured.</strong>
                        The reset link has been written to the application log.
                        Please contact your administrator, who can retrieve it from
                        <code>journalctl -u n24-data-relay</code> or the application log file.
                    </div>
                    <div class="text-center mt-3">
                        <a asp-page="/Login" class="btn btn-outline-secondary btn-sm">Back to login</a>
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-3">
                        Enter your registered email address and a reset link will be generated.
                    </p>
                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label">Email address</label>
                            <input asp-for="Input.Email" class="form-control" autocomplete="email" autofocus />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa-solid fa-paper-plane me-1"></i>Request Reset Link
                            </button>
                        </div>
                    </form>
                    <hr class="my-3">
                    <div class="text-center small">
                        <a asp-page="/Login">Back to login</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
