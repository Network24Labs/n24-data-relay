@page
@model ResultModel
@{
    ViewData["Title"] = "Upload Result";
}

<div class="card">
    <div class="card-header"><h4 class="mb-0">Upload Result</h4></div>
    <div class="card-body">
        @if (Model.Results.Count == 0)
        {
            <p>No upload results to display. <a asp-page="/Upload">Upload files</a>.</p>
        }
        else
        {
            <ul class="list-group">
                @foreach (var r in Model.Results)
                {
                    <li class="list-group-item @(r.Success ? "list-group-item-success" : "list-group-item-danger")">
                        @r.FileName: @(r.Success ? "Success" : r.ErrorMessage)
                        @if (r.Success) { <small>(@(r.FileSize) bytes, @(r.RequiresTransfer ? "for transfer" : "DMZ"))</small> }
                    </li>
                }
            </ul>
            <p class="mt-3"><a asp-page="/Upload" class="btn btn-primary">Upload more</a></p>
        }
    </div>
</div>
