@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Options
@using N24DataRelay.Core.Models
@using N24DataRelay.WebApp.Data
@inject UserManager<ApplicationUser> UserManager
@inject IOptionsMonitor<N24DataRelayConfiguration> ConfigMonitor
@{
    var auth = ConfigMonitor.CurrentValue.WebPortal.Authentication;
    if (auth.PasswordExpiryDays <= 0 || auth.PasswordExpiryWarningDays <= 0)
        return; // expiry or warning disabled

    var user = await UserManager.GetUserAsync(User);
    if (user == null || !user.PasswordLastChangedAt.HasValue)
        return;

    var expiredAt  = user.PasswordLastChangedAt.Value.AddDays(auth.PasswordExpiryDays);
    var daysLeft   = (int)Math.Ceiling((expiredAt - DateTime.UtcNow).TotalDays);

    if (daysLeft > auth.PasswordExpiryWarningDays)
        return; // still plenty of time — no banner needed
}
@if (daysLeft <= 0)
{
    <div class="alert alert-danger rounded-0 mb-0 py-2 text-center small">
        <i class="fa-solid fa-lock me-2"></i>
        <strong>Your password has expired.</strong>
        <a asp-page="/ChangePassword" asp-route-forced="true" class="alert-link ms-2">Change it now</a>
    </div>
}
else
{
    <div class="alert alert-warning rounded-0 mb-0 py-2 text-center small">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>
        Your password expires in <strong>@daysLeft day@(daysLeft == 1 ? "" : "s")</strong>.
        <a asp-page="/ChangePassword" class="alert-link ms-2">Change it now</a>
    </div>
}
