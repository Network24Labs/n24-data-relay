@page
@model LoginModel
@{
    ViewData["Title"] = "Sign In";

    var defaultMethod = Model.DefaultLoginMethod;
    var enabledMethods = new List<string>();
    if (Model.EnableEntraId) enabledMethods.Add("EntraId");
    if (Model.EnableLdap) enabledMethods.Add("Ldap");
    if (Model.EnableLocalAccounts) enabledMethods.Add("Local");

    // Fall back to the first enabled method if the configured default is not enabled
    if (!enabledMethods.Contains(defaultMethod) && enabledMethods.Any())
        defaultMethod = enabledMethods.First();

    var otherMethods = enabledMethods.Where(m => m != defaultMethod).ToList();
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card">
            <div class="card-header"><h4 class="mb-0">Sign In</h4></div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.InfoMessage))
                {
                    <div class="alert alert-info">@Model.InfoMessage</div>
                }

                @if (!enabledMethods.Any())
                {
                    <div class="alert alert-warning">No sign-in methods are enabled. Contact your administrator.</div>
                }

                @* ── Default method (shown prominently) ─────────────────────── *@
                @{ await RenderMethodAsync(defaultMethod, true); }

                @* ── Other methods (collapsible) ────────────────────────────── *@
                @if (otherMethods.Any())
                {
                    <div class="d-flex align-items-center mt-3 mb-2">
                        <hr class="flex-grow-1" />
                        <a class="px-2 text-muted small text-decoration-none" data-bs-toggle="collapse" href="#otherMethods" role="button" aria-expanded="false">
                            Other sign-in options <i class="fa-solid fa-chevron-down fa-xs ms-1"></i>
                        </a>
                        <hr class="flex-grow-1" />
                    </div>
                    <div class="collapse" id="otherMethods">
                        @foreach (var method in otherMethods)
                        {
                            if (method != otherMethods.First())
                            {
                                <div class="d-flex align-items-center my-3">
                                    <hr class="flex-grow-1" /><span class="px-2 text-muted small">or</span><hr class="flex-grow-1" />
                                </div>
                            }
                            await RenderMethodAsync(method, false);
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@functions {
    async Task RenderMethodAsync(string method, bool isDefault)
    {
        switch (method)
        {
            case "EntraId":  await RenderEntraIdAsync();           break;
            case "Ldap":     await RenderLdapAsync(isDefault);     break;
            case "Local":    await RenderLocalAsync(isDefault);     break;
        }
    }

    async Task RenderEntraIdAsync()
    {
        <a asp-page="/ExternalLogin"
           asp-route-provider="MicrosoftIdentity"
           asp-route-returnUrl="@Model.ReturnUrl"
           class="btn btn-outline-primary w-100">
            <i class="fa-brands fa-microsoft me-2"></i>Sign in with Microsoft
        </a>
        await Task.CompletedTask;
    }

    async Task RenderLdapAsync(bool isDefault)
    {
        if (!string.IsNullOrEmpty(Model.LdapErrorMessage))
        {
            <div class="alert alert-danger">@Model.LdapErrorMessage</div>
        }
        <form method="post" asp-page-handler="Ldap" asp-route-returnUrl="@Model.ReturnUrl">
            <div class="mb-3">
                <label asp-for="LdapInput.Username" class="form-label">Username</label>
                <input asp-for="LdapInput.Username" class="form-control"
                       placeholder="@(string.IsNullOrEmpty(Model.LdapDomainHint) ? "username" : Model.LdapDomainHint + "\\username")" />
                <span asp-validation-for="LdapInput.Username" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="LdapInput.Password" class="form-label">Password</label>
                <input asp-for="LdapInput.Password" class="form-control" type="password" />
                <span asp-validation-for="LdapInput.Password" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-outline-primary w-100">
                <i class="fa-solid fa-sitemap me-2"></i>Sign in with Active Directory
            </button>
        </form>
        await Task.CompletedTask;
    }

    async Task RenderLocalAsync(bool isDefault)
    {
        if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }
        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">Email</label>
                <input asp-for="Input.Email" class="form-control" type="email" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label">Password</label>
                <input asp-for="Input.Password" class="form-control" type="password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="mb-3 form-check">
                <input asp-for="Input.RememberMe" class="form-check-input" />
                <label asp-for="Input.RememberMe" class="form-check-label">Remember me</label>
            </div>
            <button type="submit" class="btn btn-primary w-100">Sign In</button>
        </form>
        <div class="mt-3 d-flex justify-content-between small">
            <a asp-page="/ForgotPassword">Forgot password?</a>
            @if (Model.EnableSelfRegistration)
            {
                <a asp-page="/Register">Create account</a>
            }
        </div>
        await Task.CompletedTask;
    }
}
