@page
@model N24DataRelay.WebApp.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "User Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="fa-solid fa-users-gear me-2"></i>User Management</h4>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ResetLink))
{
    <div class="alert alert-warning alert-dismissible" role="alert">
        <strong><i class="fa-solid fa-link me-2"></i>Reset link — share this with the user (expires in 24 hours):</strong>
        <div class="input-group mt-2">
            <input type="text" class="form-control form-control-sm font-monospace" id="resetLinkBox"
                   value="@Model.ResetLink" readonly />
            <button class="btn btn-sm btn-outline-secondary" type="button"
                    onclick="navigator.clipboard.writeText(document.getElementById('resetLinkBox').value)">
                <i class="fa-solid fa-copy"></i> Copy
            </button>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* ── Pending approvals ─────────────────────────────────────────────────── *@
@if (Model.PendingUsers.Any())
{
    <div class="card mb-4 border-warning">
        <div class="card-header bg-warning text-dark">
            <i class="fa-solid fa-clock me-2"></i>Pending Approval
            <span class="badge bg-dark ms-2">@Model.PendingUsers.Count</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm table-hover mb-0">
                <thead class="table-warning">
                    <tr>
                        <th>Email</th>
                        <th>Type</th>
                        <th>Registered</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.PendingUsers)
                    {
                        <tr>
                            <td>@u.Email</td>
                            <td>@{ RenderAccountBadge(u.AccountType); }</td>
                            <td><small>@u.RegistrationDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small></td>
                            <td>
                                <form method="post" asp-page-handler="Approve" class="d-inline">
                                    <input type="hidden" name="userId" value="@u.Id" />
                                    <button class="btn btn-sm btn-success me-1" type="submit">
                                        <i class="fa-solid fa-check me-1"></i>Approve
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="Reject" class="d-inline"
                                      onsubmit="return confirm('Remove this registration for @u.Email?')">
                                    <input type="hidden" name="userId" value="@u.Id" />
                                    <button class="btn btn-sm btn-outline-danger" type="submit">
                                        <i class="fa-solid fa-xmark me-1"></i>Reject
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-success mb-4">
        <i class="fa-solid fa-circle-check me-2"></i>No pending registrations.
    </div>
}

@* ── All users ─────────────────────────────────────────────────────────── *@
<div class="card">
    <div class="card-header">
        <i class="fa-solid fa-users me-2"></i>All Users
        <span class="badge bg-secondary ms-2">@Model.AllUsers.Count</span>
    </div>
    <div class="card-body p-0">
        <table class="table table-sm table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Email</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Role</th>
                    <th>Password</th>
                    <th>Registered</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.AllUsers)
                {
                    <tr class="@(u.IsCurrentUser ? "table-active" : "")">
                        <td>
                            @u.Email
                            @if (u.IsCurrentUser) { <span class="badge bg-secondary ms-1">you</span> }
                        </td>
                        <td>@{ RenderAccountBadge(u.AccountType); }</td>
                        <td>
                            @if (u.IsApproved) { <span class="badge bg-success">Approved</span> }
                            else { <span class="badge bg-warning text-dark">Pending</span> }
                        </td>
                        <td>
                            @if (u.IsAdmin) { <span class="badge bg-primary">Admin</span> }
                            else { <span class="badge bg-light text-dark">User</span> }
                        </td>
                        <td>
                            @if (u.HasLocalPassword)
                            {
                                var (badgeClass, badgeText, badgeTitle) = u.PasswordStatus switch
                                {
                                    "expired"  => ("bg-danger",              "Expired",
                                                   u.MustChangePassword ? "Admin forced reset" : "Password expired"),
                                    "warning"  => ("bg-warning text-dark",   $"Expires in {u.DaysUntilExpiry}d",
                                                   $"Expiring in {u.DaysUntilExpiry} day(s)"),
                                    "ok"       => ("bg-success",             u.DaysUntilExpiry.HasValue
                                                                             ? $"{u.DaysUntilExpiry}d remaining"
                                                                             : "OK",
                                                   u.PasswordLastChangedAt.HasValue
                                                       ? $"Changed {u.PasswordLastChangedAt.Value.ToLocalTime():yyyy-MM-dd}"
                                                       : "No expiry"),
                                    _          => ("bg-secondary",           "Not set",
                                                   "Password change date not recorded")
                                };
                                <span class="badge @badgeClass" title="@badgeTitle">
                                    <i class="fa-solid fa-key me-1"></i>@badgeText
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted" title="Authenticates via directory">
                                    <i class="fa-solid fa-minus me-1"></i>N/A
                                </span>
                            }
                        </td>
                        <td><small>@u.RegistrationDate.ToLocalTime().ToString("yyyy-MM-dd")</small></td>
                        <td>
                            @if (!u.IsCurrentUser)
                            {
                                if (!u.IsApproved)
                                {
                                    <form method="post" asp-page-handler="Approve" class="d-inline">
                                        <input type="hidden" name="userId" value="@u.Id" />
                                        <button class="btn btn-sm btn-success me-1" type="submit" title="Approve">
                                            <i class="fa-solid fa-check"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Revoke" class="d-inline"
                                          onsubmit="return confirm('Revoke access for @u.Email?')">
                                        <input type="hidden" name="userId" value="@u.Id" />
                                        <button class="btn btn-sm btn-outline-warning me-1" type="submit" title="Revoke access">
                                            <i class="fa-solid fa-ban"></i>
                                        </button>
                                    </form>
                                }
                                <form method="post" asp-page-handler="ToggleAdmin" class="d-inline">
                                    <input type="hidden" name="userId" value="@u.Id" />
                                    <button class="btn btn-sm @(u.IsAdmin ? "btn-outline-secondary" : "btn-outline-primary") me-1"
                                            type="submit" title="@(u.IsAdmin ? "Remove Admin" : "Make Admin")">
                                        <i class="fa-solid @(u.IsAdmin ? "fa-user-minus" : "fa-user-shield")"></i>
                                    </button>
                                </form>
                                @if (u.HasLocalPassword)
                                {
                                    <form method="post" asp-page-handler="ForceReset" class="d-inline"
                                          onsubmit="return confirm('Force a password reset for @u.Email?')">
                                        <input type="hidden" name="userId" value="@u.Id" />
                                        <button class="btn btn-sm btn-outline-info me-1" type="submit"
                                                title="Force password reset — generates a reset link">
                                            <i class="fa-solid fa-key"></i>
                                        </button>
                                    </form>
                                    <form method="post" asp-page-handler="GenerateResetLink" class="d-inline">
                                        <input type="hidden" name="userId" value="@u.Id" />
                                        <button class="btn btn-sm btn-outline-secondary me-1" type="submit"
                                                title="Generate a reset link to share manually">
                                            <i class="fa-solid fa-link"></i>
                                        </button>
                                    </form>
                                }
                                <form method="post" asp-page-handler="Reject" class="d-inline"
                                      onsubmit="return confirm('Delete @u.Email permanently?')">
                                    <input type="hidden" name="userId" value="@u.Id" />
                                    <button class="btn btn-sm btn-outline-danger" type="submit" title="Delete user">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.AllUsers.Any())
        {
            <p class="text-muted p-3 mb-0">No users registered yet.</p>
        }
    </div>
</div>

@functions {
    void RenderAccountBadge(string accountType)
    {
        foreach (var part in accountType.Split(" + "))
        {
            var trimmed = part.Trim();
            var (cls, icon) = trimmed switch
            {
                "Entra ID" => ("bg-primary",       "fa-brands fa-microsoft"),
                "AD/LDAP"  => ("bg-info text-dark", "fa-solid fa-sitemap"),
                _          => ("bg-secondary",      "fa-solid fa-user")
            };
            <span class="badge @cls me-1"><i class="@icon me-1"></i>@trimmed</span>
        }
    }
}
