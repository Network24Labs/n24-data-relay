@page
@model N24DataRelay.WebApp.Pages.Admin.SettingsModel
@{
    ViewData["Title"] = "System Settings";
    var activeTab = (Model.ActiveTab ?? "ssh");
}

<div class="d-flex align-items-center mb-4 gap-2">
    <i class="fa-solid fa-sliders fa-lg text-primary"></i>
    <h1 class="h3 mb-0">System Settings</h1>
    <span class="badge bg-secondary ms-auto font-monospace small" title="Active config write target">
        <i class="fa-solid fa-file-pen me-1"></i>@Model.WritePath
    </span>
</div>

@if (Model.StatusMessage != null)
{
    var isError = Model.StatusMessage.StartsWith("Error", StringComparison.OrdinalIgnoreCase);
    <div class="alert alert-@(isError ? "danger" : "success") alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-@(isError ? "circle-exclamation" : "circle-check") me-2"></i>@Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* ── Config health bar ───────────────────────────────────────────────────── *@
@{
    var transferMethod = (Model.Config.Service.TransferMethod ?? "ssh").ToLowerInvariant();
    var sshOk   = !string.IsNullOrWhiteSpace(Model.Config.Transfer.Ssh.Host)
               && !string.IsNullOrWhiteSpace(Model.Config.Transfer.Ssh.Username);
    var keyOk   = Model.Config.Transfer.Ssh.AuthMethod != "PublicKey"
               || !string.IsNullOrWhiteSpace(Model.Config.Transfer.Ssh.PrivateKeyPath);
    var smbOk   = !string.IsNullOrWhiteSpace(Model.Config.Transfer.Smb.SharePath);
    var watchOk = !string.IsNullOrWhiteSpace(Model.Config.Service.WatchDirectory);
}
<div class="d-flex flex-wrap gap-2 mb-4">
    @if (transferMethod == "smb")
    {
        <span class="badge @(smbOk ? "bg-success" : "bg-warning text-dark") fs-6 fw-normal py-2 px-3">
            <i class="fa-solid fa-@(smbOk ? "check" : "triangle-exclamation") me-1"></i>SMB share @(smbOk ? "configured" : "not set")
        </span>
    }
    else
    {
        <span class="badge @(sshOk ? "bg-success" : "bg-warning text-dark") fs-6 fw-normal py-2 px-3">
            <i class="fa-solid fa-@(sshOk ? "check" : "triangle-exclamation") me-1"></i>SSH host @(sshOk ? "configured" : "not set")
        </span>
        <span class="badge @(keyOk ? "bg-success" : "bg-warning text-dark") fs-6 fw-normal py-2 px-3">
            <i class="fa-solid fa-@(keyOk ? "check" : "triangle-exclamation") me-1"></i>SSH key @(keyOk ? "set" : "not set")
        </span>
    }
    <span class="badge @(watchOk ? "bg-success" : "bg-warning text-dark") fs-6 fw-normal py-2 px-3">
        <i class="fa-solid fa-@(watchOk ? "check" : "triangle-exclamation") me-1"></i>Watch directory @(watchOk ? "configured" : "not set")
    </span>
    <span class="badge bg-secondary fs-6 fw-normal py-2 px-3">
        <i class="fa-solid fa-arrow-right-arrow-left me-1"></i>Method: @transferMethod.ToUpperInvariant()
    </span>
</div>

@* ── Nav tabs ────────────────────────────────────────────────────────────── *@
<ul class="nav nav-tabs mb-4" id="settingsTabs" role="tablist">
    <li class="nav-item">
        <a class="nav-link @(activeTab == "ssh" ? "active" : "")" href="#ssh" data-bs-toggle="tab" role="tab">
            <i class="fa-solid fa-terminal me-1"></i>SSH Target
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(activeTab == "smb" ? "active" : "")" href="#smb" data-bs-toggle="tab" role="tab">
            <i class="fa-solid fa-folder-open me-1"></i>SMB Target
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(activeTab == "service" ? "active" : "")" href="#service" data-bs-toggle="tab" role="tab">
            <i class="fa-solid fa-gears me-1"></i>Transfer Service
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(activeTab == "portal" ? "active" : "")" href="#portal" data-bs-toggle="tab" role="tab">
            <i class="fa-solid fa-globe me-1"></i>Web Portal
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(activeTab == "branding" ? "active" : "")" href="#branding" data-bs-toggle="tab" role="tab">
            <i class="fa-solid fa-palette me-1"></i>Branding
        </a>
    </li>
</ul>

<div class="tab-content">

    @* ══ Tab 1: SSH ══════════════════════════════════════════════════════════ *@
    <div class="tab-pane fade @(activeTab == "ssh" ? "show active" : "")" id="ssh" role="tabpanel">
        <form method="post" asp-page-handler="SaveSsh">
            <div class="card">
                <div class="card-header fw-semibold"><i class="fa-solid fa-server me-2"></i>SCADA Transfer Target — SSH Connection</div>
                <div class="card-body row g-3">

                    <div class="col-md-8">
                        <label asp-for="Ssh.Host" class="form-label">Host <span class="text-danger">*</span></label>
                        <input asp-for="Ssh.Host" class="form-control font-monospace" placeholder="192.168.10.50 or scada.internal" />
                        <span asp-validation-for="Ssh.Host" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Ssh.Port" class="form-label">Port</label>
                        <input asp-for="Ssh.Port" type="number" class="form-control" min="1" max="65535" />
                        <span asp-validation-for="Ssh.Port" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Ssh.Username" class="form-label">Username <span class="text-danger">*</span></label>
                        <input asp-for="Ssh.Username" class="form-control font-monospace" placeholder="relay" />
                        <span asp-validation-for="Ssh.Username" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Ssh.DestinationPath" class="form-label">Destination Path <span class="text-danger">*</span></label>
                        <input asp-for="Ssh.DestinationPath" class="form-control font-monospace" placeholder="/opt/relay/incoming" />
                        <span asp-validation-for="Ssh.DestinationPath" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Authentication Method</label>
                        <div class="d-flex gap-3 mt-1">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="Ssh.AuthMethod" value="PublicKey" id="authPk" />
                                <label class="form-check-label" for="authPk"><i class="fa-solid fa-key me-1"></i>Public Key</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="Ssh.AuthMethod" value="Password" id="authPwd" />
                                <label class="form-check-label" for="authPwd"><i class="fa-solid fa-lock me-1"></i>Password</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Remote Server Type</label>
                        <div class="d-flex gap-3 mt-1">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="Ssh.RemoteServerType" value="Linux" id="stLinux" />
                                <label class="form-check-label" for="stLinux">Linux</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="Ssh.RemoteServerType" value="Windows" id="stWin" />
                                <label class="form-check-label" for="stWin">Windows</label>
                            </div>
                        </div>
                    </div>

                    <div class="col-12" id="keyPathRow">
                        <label asp-for="Ssh.PrivateKeyPath" class="form-label">Private Key Path</label>
                        <input asp-for="Ssh.PrivateKeyPath" class="form-control font-monospace" placeholder="/etc/n24-data-relay/keys/id_ed25519" />
                        <div class="form-text">
                            Leave blank to use the default key. Set the passphrase via the
                            <code>N24_SSH_KEY_PASSPHRASE</code> environment variable (not stored in config).
                        </div>
                    </div>

                    <div class="col-md-8" id="passwordRow">
                        <label asp-for="Ssh.Password" class="form-label">Password</label>
                        <div class="input-group">
                            <input asp-for="Ssh.Password" type="password" class="form-control font-monospace"
                                   placeholder="Leave blank to keep existing" autocomplete="new-password" id="sshPasswordInput" />
                            <button class="btn btn-outline-secondary" type="button" id="toggleSshPassword" title="Show/hide">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                        <div class="form-text">
                            Stored encrypted using the application data-protection key.
                            Prefer the <code>N24_SSH_KEY_PASSPHRASE</code> environment variable for public-key auth.
                        </div>
                    </div>

                    @* ── Advanced ─────────────────────────────────────── *@
                    <div class="col-12">
                        <a class="text-decoration-none small" data-bs-toggle="collapse" href="#sshAdvanced">
                            <i class="fa-solid fa-chevron-down me-1"></i>Advanced options
                        </a>
                        <div class="collapse mt-2" id="sshAdvanced">
                            <div class="card card-body bg-body-secondary row g-3">
                                <div class="col-md-4">
                                    <label asp-for="Ssh.ConnectionTimeout" class="form-label">Connection Timeout (s)</label>
                                    <input asp-for="Ssh.ConnectionTimeout" type="number" class="form-control" min="10" max="300" />
                                    <span asp-validation-for="Ssh.ConnectionTimeout" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="Ssh.OperationTimeout" class="form-label">Operation Timeout (s)</label>
                                    <input asp-for="Ssh.OperationTimeout" type="number" class="form-control" min="60" max="3600" />
                                    <span asp-validation-for="Ssh.OperationTimeout" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4 d-flex flex-column justify-content-end pb-1 gap-2">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" asp-for="Ssh.Compression" />
                                        <label class="form-check-label" asp-for="Ssh.Compression">Enable Compression</label>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" asp-for="Ssh.StrictHostKeyChecking" id="strictHostChk" />
                                        <label class="form-check-label" asp-for="Ssh.StrictHostKeyChecking">Strict Host Key Checking</label>
                                    </div>
                                </div>
                                <div class="col-12" id="fingerprintRow">
                                    <label asp-for="Ssh.KnownHostFingerprint" class="form-label">Known Host Fingerprint (SHA-256)</label>
                                    <input asp-for="Ssh.KnownHostFingerprint" class="form-control font-monospace"
                                           placeholder="e.g. a1b2c3d4e5f6..." />
                                    <div class="form-text">
                                        Required when <strong>Strict Host Key Checking</strong> is enabled.
                                        Obtain via: <code>ssh-keyscan -p @Model.Config.Transfer.Ssh.Port @(Model.Config.Transfer.Ssh.Host != "" ? Model.Config.Transfer.Ssh.Host : "&lt;host&gt;") | ssh-keygen -lf - -E sha256</code>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-between align-items-center gap-2">
                    <button type="button" class="btn btn-outline-secondary"
                            onclick="testConnection(this)"
                            data-handler="TestConnection"
                            title="Tests connectivity using the currently saved SSH settings">
                        <i class="fa-solid fa-plug me-1"></i>Test Connection
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-floppy-disk me-1"></i>Save SSH Settings
                    </button>
                </div>
            </div>
        </form>
    </div>

    @* ══ Tab 2: SMB ═══════════════════════════════════════════════════════════ *@
    <div class="tab-pane fade @(activeTab == "smb" ? "show active" : "")" id="smb" role="tabpanel">
        <form method="post" asp-page-handler="SaveSmb">
            <div class="card">
                <div class="card-header fw-semibold"><i class="fa-solid fa-server me-2"></i>SCADA Transfer Target — SMB Share</div>
                <div class="card-body row g-3">

                    <div class="col-12">
                        <div class="alert alert-info py-2 mb-0 small">
                            <i class="fa-solid fa-circle-info me-1"></i>
                            The SMB share must be <strong>mounted on this server</strong> before the service starts.
                            Use <code>/etc/fstab</code> or a systemd mount unit with a <code>cifs</code> type.
                            N24 Data Relay copies files to the mount point using standard file I/O — no SMB library required.
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Smb.Server" class="form-label">Server / UNC Host</label>
                        <input asp-for="Smb.Server" class="form-control font-monospace"
                               placeholder="192.168.10.50 or scada.internal" />
                        <div class="form-text">Informational only — used in transfer records and audit log.</div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Smb.SharePath" class="form-label">Local Mount Path <span class="text-danger">*</span></label>
                        <input asp-for="Smb.SharePath" class="form-control font-monospace"
                               placeholder="/mnt/scada-share" />
                        <div class="form-text">The local directory where the CIFS share is mounted.</div>
                        <span asp-validation-for="Smb.SharePath" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Smb.Timeout" class="form-label">Copy Timeout (s)</label>
                        <input asp-for="Smb.Timeout" type="number" class="form-control" min="30" max="3600" />
                        <span asp-validation-for="Smb.Timeout" class="text-danger small"></span>
                    </div>

                    @* ── CIFS credentials hint ────────────────────────────── *@
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="Smb.UseCredentials" id="smbCredsToggle" />
                            <label class="form-check-label" asp-for="Smb.UseCredentials">
                                Share requires credentials (CIFS)
                            </label>
                        </div>
                    </div>
                    <div id="smbCredFields" class="col-12 row g-3 mx-0 px-0">
                        <div class="col-md-5">
                            <label asp-for="Smb.Username" class="form-label">Domain Username</label>
                            <input asp-for="Smb.Username" class="form-control font-monospace"
                                   placeholder="DOMAIN\relay or relay@domain.local" autocomplete="off" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Smb.Domain" class="form-label">Domain</label>
                            <input asp-for="Smb.Domain" class="form-control font-monospace"
                                   placeholder="DOMAIN" autocomplete="off" />
                            <div class="form-text">Optional if embedded in username.</div>
                        </div>
                        <div class="col-12">
                            <div class="alert alert-secondary py-2 mb-0 small">
                                <i class="fa-solid fa-circle-info me-1"></i>
                                CIFS passwords are not stored here. Add a credentials file to
                                <code>/etc/n24-data-relay/smb-credentials</code> (mode <code>600</code>) and reference it in
                                <code>/etc/fstab</code>:
                                <pre class="mt-2 mb-0 bg-body-tertiary rounded p-2">//server/share  /mnt/scada-share  cifs  credentials=/etc/n24-data-relay/smb-credentials,uid=n24relay,gid=n24relay,vers=3.0  0  0</pre>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-between align-items-center gap-2">
                    <button type="button" class="btn btn-outline-secondary"
                            onclick="testConnection(this)"
                            data-handler="TestConnection"
                            title="Tests whether the configured mount path exists and is accessible">
                        <i class="fa-solid fa-plug me-1"></i>Test Connection
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-floppy-disk me-1"></i>Save SMB Settings
                    </button>
                </div>
            </div>
        </form>
    </div>

    @* ══ Tab 3: Transfer Service ══════════════════════════════════════════════ *@
    <div class="tab-pane fade @(activeTab == "service" ? "show active" : "")" id="service" role="tabpanel">
        <form method="post" asp-page-handler="SaveService">
            <div class="card mb-4">
                <div class="card-header fw-semibold"><i class="fa-solid fa-folder-open me-2"></i>Directories</div>
                <div class="card-body row g-3">
                    <div class="col-12">
                        <label asp-for="Service.WatchDirectory" class="form-label">Watch Directory <span class="text-danger">*</span></label>
                        <input asp-for="Service.WatchDirectory" class="form-control font-monospace" placeholder="/var/lib/n24-data-relay/uploads/transfer" />
                        <div class="form-text">Files placed here are automatically queued for transfer to SCADA.</div>
                        <span asp-validation-for="Service.WatchDirectory" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header fw-semibold"><i class="fa-solid fa-file-circle-check me-2"></i>File Handling</div>
                <div class="card-body row g-3">
                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="Service.DeleteAfterTransfer" id="delAfter" />
                            <label class="form-check-label" asp-for="Service.DeleteAfterTransfer">Delete source file after successful transfer</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="Service.VerifyTransfer" />
                            <label class="form-check-label" asp-for="Service.VerifyTransfer">Verify file integrity after transfer</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="Service.ArchiveAfterTransfer" id="archAfter" />
                            <label class="form-check-label" asp-for="Service.ArchiveAfterTransfer">Archive file after transfer</label>
                        </div>
                    </div>
                    <div class="col-12" id="archiveDirRow">
                        <label asp-for="Service.ArchiveDirectory" class="form-label">Archive Directory</label>
                        <input asp-for="Service.ArchiveDirectory" class="form-control font-monospace" placeholder="/var/lib/n24-data-relay/archive" />
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header fw-semibold"><i class="fa-solid fa-rotate me-2"></i>Retry &amp; Timing</div>
                <div class="card-body row g-3">
                    <div class="col-md-4">
                        <label asp-for="Service.RetryAttempts" class="form-label">Retry Attempts</label>
                        <input asp-for="Service.RetryAttempts" type="number" class="form-control" min="0" max="10" />
                        <span asp-validation-for="Service.RetryAttempts" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Service.RetryDelaySeconds" class="form-label">Retry Delay (s)</label>
                        <input asp-for="Service.RetryDelaySeconds" type="number" class="form-control" min="5" max="300" />
                        <span asp-validation-for="Service.RetryDelaySeconds" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Service.RetryBackoffMultiplier" class="form-label">Backoff Multiplier</label>
                        <input asp-for="Service.RetryBackoffMultiplier" type="number" step="0.1" class="form-control" min="1" max="5" />
                        <span asp-validation-for="Service.RetryBackoffMultiplier" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Service.FileStabilitySeconds" class="form-label">File Stability Grace Period (s)</label>
                        <input asp-for="Service.FileStabilitySeconds" type="number" class="form-control" min="1" max="60" />
                        <div class="form-text">Wait this long after last file write before transferring.</div>
                        <span asp-validation-for="Service.FileStabilitySeconds" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Service.ProcessingIntervalSeconds" class="form-label">Polling Interval (s)</label>
                        <input asp-for="Service.ProcessingIntervalSeconds" type="number" class="form-control" min="5" max="300" />
                        <span asp-validation-for="Service.ProcessingIntervalSeconds" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Service.MaxConcurrentTransfers" class="form-label">Max Concurrent Transfers</label>
                        <input asp-for="Service.MaxConcurrentTransfers" type="number" class="form-control" min="1" max="50" />
                        <div class="form-text">Parallel transfers per processing cycle.</div>
                        <span asp-validation-for="Service.MaxConcurrentTransfers" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Service.MaxQueueSize" class="form-label">Max Queue Size</label>
                        <input asp-for="Service.MaxQueueSize" type="number" class="form-control" min="10" max="100000" />
                        <div class="form-text">New files are dropped if the queue exceeds this limit.</div>
                        <span asp-validation-for="Service.MaxQueueSize" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Service.FileFilter" class="form-label">File Filter</label>
                        <input asp-for="Service.FileFilter" class="form-control font-monospace" placeholder="*.*" />
                        <div class="form-text">
                            Controls which files in the watch directory trigger a transfer.
                            Uses a single <strong>FileSystemWatcher</strong> pattern — <code>*</code> matches any characters,
                            <code>?</code> matches one character.<br />
                            Examples: <code>*.*</code> (all files), <code>*.csv</code> (CSV only),
                            <code>*.dat</code>, <code>report_???.xlsx</code>.<br />
                            <span class="text-warning-emphasis">Only one pattern is supported. To restrict multiple file types, use
                            <code>*.*</code> here and configure the <strong>Blocked File Extensions</strong> list on the
                            <a href="#portal" data-bs-toggle="tab">Web Portal tab</a> — uploads of disallowed extensions
                            are rejected before they reach the watch directory.</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="text-end">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-floppy-disk me-1"></i>Save Transfer Settings
                </button>
            </div>
        </form>
    </div>

    @* ══ Tab 4: Web Portal ═══════════════════════════════════════════════════ *@
    <div class="tab-pane fade @(activeTab == "portal" ? "show active" : "")" id="portal" role="tabpanel">
        <form method="post" asp-page-handler="SavePortal">
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Keys.Any(k => k.StartsWith("Portal.")))
            {
                <div class="alert alert-danger mb-3">
                    <strong><i class="fa-solid fa-triangle-exclamation me-1"></i>Validation errors prevented saving:</strong>
                    <ul class="mb-0 mt-1">
                        @foreach (var entry in ViewData.ModelState.Where(e => e.Key.StartsWith("Portal.") && e.Value?.Errors.Count > 0))
                        {
                            foreach (var error in entry.Value!.Errors)
                            {
                                <li><code>@(entry.Key.Replace("Portal.", ""))</code>: @error.ErrorMessage</li>
                            }
                        }
                    </ul>
                </div>
            }
            <div class="card mb-4">
                <div class="card-header fw-semibold"><i class="fa-solid fa-network-wired me-2"></i>Network &amp; TLS</div>
                <div class="card-body row g-3">
                    <div class="col-md-4">
                        <label asp-for="Portal.HttpPort" class="form-label">HTTP Port</label>
                        <input asp-for="Portal.HttpPort" type="number" class="form-control" min="1" max="65535" />
                        <span asp-validation-for="Portal.HttpPort" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Portal.HttpsPort" class="form-label">HTTPS Port</label>
