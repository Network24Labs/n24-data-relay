                    <div class="col-12" id="certPathRow">
                        <label asp-for="Portal.CertificatePath" class="form-label">TLS Certificate Path (.pfx)</label>
                        <input asp-for="Portal.CertificatePath" class="form-control font-monospace" placeholder="/etc/n24-data-relay/certs/relay.pfx" />
