                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header fw-semibold"><i class="fa-solid fa-upload me-2"></i>Upload Configuration</div>
                <div class="card-body row g-3">
                    <div class="col-12">
                        <label asp-for="Portal.UploadDirectory" class="form-label">Upload Directory <span class="text-danger">*</span></label>
                        <input asp-for="Portal.UploadDirectory" class="form-control font-monospace" placeholder="/var/lib/n24-data-relay/uploads" />
                        <div class="form-text">Uploaded files are staged here before being moved to the watch directory.</div>
                        <span asp-validation-for="Portal.UploadDirectory" class="text-danger small"></span>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="Portal.MaxFileSizeGb" class="form-label">Max File Size (GB)</label>
                        <input asp-for="Portal.MaxFileSizeGb" type="number" step="0.1" class="form-control" min="0.1" max="100" />
                        <span asp-validation-for="Portal.MaxFileSizeGb" class="text-danger small"></span>
                    </div>
                    <div class="col-md-7">
                        <label asp-for="Portal.BlockedExtensions" class="form-label">Blocked File Extensions</label>
                        <input asp-for="Portal.BlockedExtensions" class="form-control font-monospace" placeholder=".exe, .dll, .bat, .cmd, .ps1" />
                        <div class="form-text">Comma-separated, include the leading dot.</div>
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="Portal.EnableUploadToTransfer" />
                            <label class="form-check-label" asp-for="Portal.EnableUploadToTransfer">
                                Automatically move uploaded files to watch directory for transfer
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header fw-semibold"><i class="fa-solid fa-user-shield me-2"></i>Authentication</div>
                <div class="card-body row g-3">
                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="Portal.EnableLocalAccounts" />
                            <label class="form-check-label" asp-for="Portal.EnableLocalAccounts">Enable local account registration</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="Portal.RequireApproval" />
                            <label class="form-check-label" asp-for="Portal.RequireApproval">Require admin approval for new accounts</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Portal.PasswordExpiryDays" class="form-label">Password Expiry (days)</label>
                        <input asp-for="Portal.PasswordExpiryDays" type="number" class="form-control" min="0" max="3650" />
                        <div class="form-text">0 = passwords never expire.</div>
                        <span asp-validation-for="Portal.PasswordExpiryDays" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Portal.PasswordExpiryWarningDays" class="form-label">Expiry Warning (days before)</label>
                        <input asp-for="Portal.PasswordExpiryWarningDays" type="number" class="form-control" min="0" max="365" />
                        <div class="form-text">0 = no warning banner.</div>
                        <span asp-validation-for="Portal.PasswordExpiryWarningDays" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            @* ── Entra ID (Azure AD) card ────────────────────────────────────── *@
            <div class="card mb-4 border-primary">
                <div class="card-header fw-semibold bg-primary bg-opacity-10">
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" asp-for="Portal.EnableEntraId" id="entraToggle" />
                        <label class="form-check-label fw-semibold" asp-for="Portal.EnableEntraId">
                            <i class="fa-brands fa-microsoft me-1"></i>Enable Entra ID (Azure AD) Authentication
                        </label>
                    </div>
                </div>
                <div id="entraFields" class="card-body row g-3">
                    <div class="col-12">
                        <div class="alert alert-info py-2 mb-0 small">
                            <i class="fa-solid fa-circle-info me-1"></i>
                            These values are written to the <strong>AzureAd</strong> section of the config file.
                            For production, set the Client Secret via the
                            <code>AzureAd__ClientSecret</code> environment variable instead of storing it in the file.
                            After saving, restart the service for Entra ID to take effect.
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Portal.EntraIdTenantId" class="form-label">
                            Tenant ID <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Portal.EntraIdTenantId" class="form-control font-monospace"
                               placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" autocomplete="off" />
                        <div class="form-text">Found in Azure portal → Azure Active Directory → Overview.</div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Portal.EntraIdClientId" class="form-label">
                            Client ID (Application ID) <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Portal.EntraIdClientId" class="form-control font-monospace"
                               placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" autocomplete="off" />
                        <div class="form-text">Found in Azure portal → App registrations → your app → Overview.</div>
                    </div>

                    @* ── Credential mode ──────────────────────────────────────── *@
                    <div class="col-12">
                        <label class="form-label fw-semibold">Credential Mode</label>
                        <div class="d-flex gap-4 mt-1">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="Portal.EntraIdCredentialMode"
                                       value="Secret" id="credSecret" />
                                <label class="form-check-label" for="credSecret">
                                    <i class="fa-solid fa-key me-1 text-warning"></i>Client Secret
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="Portal.EntraIdCredentialMode"
                                       value="ManagedIdentity" id="credMI" />
                                <label class="form-check-label" for="credMI">
                                    <i class="fa-solid fa-shield-halved me-1 text-success"></i>Managed Identity
                                    <span class="badge bg-success ms-1">Recommended</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    @* ── Secret fields (shown when credentialMode = Secret) ────── *@
                    <div id="secretFields" class="col-12 row g-3 mx-0 px-0">
                        <div class="col-md-8">
                            <label asp-for="Portal.EntraIdClientSecret" class="form-label">Client Secret</label>
                            <div class="input-group">
                                <input asp-for="Portal.EntraIdClientSecret" type="password"
                                       class="form-control font-monospace"
                                       placeholder="Leave blank to keep existing"
                                       autocomplete="new-password" />
                                <button class="btn btn-outline-secondary" type="button" id="toggleSecret" title="Show/hide">
                                    <i class="fa-solid fa-eye"></i>
                                </button>
                            </div>
                            <div class="form-text d-flex align-items-center gap-2 mt-1">
                                Current status:
                                @{
                                    var secretBadgeClass = Model.EntraIdSecretStatus == "not set"
                                        ? "bg-warning text-dark"
                                        : Model.EntraIdSecretStatus == "managed identity"
                                            ? "bg-success"
                                            : "bg-success";
                                }
                                <span class="badge @secretBadgeClass">@Model.EntraIdSecretStatus</span>
                                @if (Model.EntraIdSecretStatus == "set in config file")
                                {
                                    <span class="text-muted small">— Prefer <code>AzureAd__ClientSecret</code> env var for production</span>
                                }
                            </div>
                        </div>
                    </div>

                    @* ── Managed identity fields (shown when credentialMode = ManagedIdentity) *@
                    <div id="managedIdentityFields" class="col-12 row g-3 mx-0 px-0">
                        <div class="col-md-8">
                            <label asp-for="Portal.ManagedIdentityClientId" class="form-label">
                                Managed Identity Client ID
                                <span class="text-muted fw-normal">(optional)</span>
                            </label>
                            <input asp-for="Portal.ManagedIdentityClientId" class="form-control font-monospace"
                                   placeholder="Leave blank for system-assigned identity" />
                            <div class="form-text">
                                Leave blank to use the Arc server's system-assigned managed identity.
                                Specify a Client ID only if you created a user-assigned identity.
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="alert alert-success py-3 mb-0">
                                <h6 class="alert-heading mb-2">
                                    <i class="fa-solid fa-circle-check me-1"></i>Azure Arc — Workload Identity Setup
                                </h6>
                                <p class="mb-2 small">
                                    With managed identity, no client secret is ever stored. The Arc agent on this server
                                    provides a signed token assertion that Entra ID trusts via a
                                    <strong>Federated Identity Credential</strong> on your app registration.
                                </p>
                                <ol class="small mb-0">
                                    <li class="mb-1">
                                        <strong>Enrol this server in Azure Arc</strong> (if not already done) and confirm
                                        the <em>Azure Connected Machine Agent</em> is running:
                                        <code class="d-block mt-1">systemctl status himdsd</code>
                                    </li>
                                    <li class="mb-1">
                                        In the Azure portal, open <strong>Azure Arc → Servers → &lt;this server&gt;</strong>
                                        and copy the <strong>Object (principal) ID</strong> of its managed identity.
                                    </li>
                                    <li class="mb-1">
                                        Open <strong>Microsoft Entra ID → App registrations → &lt;your app&gt; →
                                        Certificates &amp; secrets → Federated credentials → Add</strong>.
                                        <ul class="mt-1">
                                            <li>Scenario: <em>Other issuer</em></li>
                                            <li>Issuer: <code>https://sts.windows.net/@(Model.Portal.EntraIdTenantId != "" ? Model.Portal.EntraIdTenantId : "&lt;your-tenant-id&gt;")/</code></li>
                                            <li>Subject identifier: the Object ID copied above</li>
                                        </ul>
                                    </li>
                                    <li class="mb-1">
                                        Save this page — the config will contain a <code>ClientCredentials</code> array
                                        instead of <code>ClientSecret</code>. <strong>Restart the service</strong> for it
                                        to take effect.
                                    </li>
                                    <li>
                                        <strong>Delete the app registration's client secrets</strong> once you have
                                        verified the managed identity login works.
                                    </li>
                                </ol>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Portal.EntraIdCallbackPath" class="form-label">Callback Path</label>
                        <input asp-for="Portal.EntraIdCallbackPath" class="form-control font-monospace"
                               placeholder="/signin-oidc" />
                        <div class="form-text">Must match your app registration's Redirect URI.</div>
                    </div>

                    <div class="col-12">
                        <label asp-for="Portal.EntraIdInstance" class="form-label">Authority Instance</label>
                        <input asp-for="Portal.EntraIdInstance" class="form-control font-monospace"
                               placeholder="https://login.microsoftonline.com/" />
                        <div class="form-text">
                            Use the default for standard Microsoft 365 / commercial tenants.
                            Sovereign clouds: <code>https://login.microsoftonline.us/</code> (US Gov),
                            <code>https://login.chinacloudapi.cn/</code> (China).
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="alert alert-secondary py-2 mb-0 small">
                            <strong>App registration — general checklist:</strong>
                            <ol class="mb-0 mt-1">
                                <li>Platform: <strong>Web</strong> → Redirect URI: <code>https://&lt;your-host&gt;@(Model.Portal.EntraIdCallbackPath)</code></li>
                                <li>API permissions: <strong>openid</strong>, <strong>profile</strong>, <strong>email</strong> (delegated, admin consent granted)</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>

            @* ── Monitoring API card ──────────────────────────────────────────── *@
            <div class="card mb-4">
                <div class="card-header fw-semibold">
                    <i class="fa-solid fa-plug me-2"></i>Monitoring API Key
                </div>
                <div class="card-body row g-3">
                    <div class="col-12">
                        <div class="alert alert-info py-2 mb-0 small">
                            <i class="fa-solid fa-circle-info me-1"></i>
                            The monitoring API (<code>/api/v1/transfers</code>, <code>/api/v1/audit</code>)
                            requires a <strong>Bearer</strong> token in the <code>Authorization</code> header.
                            Leave blank to keep the current key. Prefer setting via the
                            <code>N24DataRelay__WebPortal__Authentication__ApiKey</code> environment variable.
                        </div>
                    </div>
                    <div class="col-md-8">
                        <label asp-for="Portal.ApiKey" class="form-label">API Key</label>
                        <div class="input-group">
                            <input asp-for="Portal.ApiKey" type="password" class="form-control font-monospace"
                                   placeholder="Leave blank to keep existing key"
                                   autocomplete="new-password" id="apiKeyInput" />
                            <button class="btn btn-outline-secondary" type="button" id="toggleApiKey" title="Show/hide">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                        <div class="form-text">
                            Current status:
                            @{
                                var apiKeyStatus = string.IsNullOrWhiteSpace(Model.Config.WebPortal.Authentication.ApiKey) ? "not set" : "configured";
                                var apiKeyBadge = apiKeyStatus == "not set" ? "bg-warning text-dark" : "bg-success";
                            }
                            <span class="badge @apiKeyBadge">@apiKeyStatus</span>
                            &mdash; Use a long random string (32+ chars).
                        </div>
                    </div>
                </div>
            </div>

            @* ── Monitoring Integrations (read-only reference card) ───────────── *@
            @{
                var apiBaseUrl = Model.ApiBaseUrl;
                var hasApiKey  = !string.IsNullOrWhiteSpace(Model.Config.WebPortal.Authentication.ApiKey);
                var apiKeyPlaceholder = hasApiKey ? "YOUR_API_KEY_HERE" : "<set an API key above first>";

                var logscaleYaml = $@"# LogScale / Falcon Next-Gen SIEM — Collector configuration
# Place in: /etc/humio-log-collector/config.yaml
dataDirectory: /var/lib/humio-log-collector/data

sources:
  n24-transfers:
    type: http-poll
    url: {apiBaseUrl}/transfers?limit=500
    headers:
      Authorization: ""Bearer {apiKeyPlaceholder}""
    interval: 60s
    parser: json
    repository: YOUR_REPOSITORY

  n24-audit:
    type: http-poll
    url: {apiBaseUrl}/audit?limit=500
    headers:
      Authorization: ""Bearer {apiKeyPlaceholder}""
    interval: 60s
    parser: json
    repository: YOUR_REPOSITORY";
            }
            <div class="card mb-4 border-0 bg-light">
                <div class="card-header fw-semibold bg-light border-bottom">
                    <i class="fa-solid fa-link me-2"></i>Monitoring Integration Reference
                </div>
                <div class="card-body row g-3">
                    @* DB path *@
                    <div class="col-12">
                        <label class="form-label fw-semibold">SQLite Database Path</label>
                        <div class="input-group">
                            <input type="text" class="form-control font-monospace"
                                   value="@Model.DbFilePath" readonly id="dbPathInput" />
                            <button class="btn btn-outline-secondary" type="button"
                                    onclick="copyField('dbPathInput', this)" title="Copy path">
                                <i class="fa-solid fa-copy"></i>
                            </button>
                        </div>
                        <div class="form-text">
                            Use with the <a href="https://grafana.com/grafana/plugins/frser-sqlite-datasource/" target="_blank" rel="noopener">Grafana SQLite datasource plugin</a>
                            for read-only dashboards on this host.
                        </div>
                    </div>

                    @* API base URL *@
                    <div class="col-12">
                        <label class="form-label fw-semibold">API Base URL</label>
                        <div class="input-group">
                            <input type="text" class="form-control font-monospace"
                                   value="@apiBaseUrl" readonly id="apiBaseUrlInput" />
                            <button class="btn btn-outline-secondary" type="button"
                                    onclick="copyField('apiBaseUrlInput', this)" title="Copy URL">
                                <i class="fa-solid fa-copy"></i>
                            </button>
                        </div>
                        <div class="form-text">
                            Endpoints: <code>/transfers</code>, <code>/audit</code>, <code>/health</code> —
                            all accept <code>?since=&lt;ISO8601&gt;&amp;limit=500</code> query params.
                        </div>
                    </div>

                    @* Swagger quick-start guide *@
                    <div class="col-12">
                        <div class="card border-primary-subtle">
                            <div class="card-header bg-primary-subtle fw-semibold small">
                                <i class="fa-solid fa-book-open me-2"></i>How to use the API (Swagger UI)
                            </div>
                            <div class="card-body small py-2">
                                <ol class="mb-2 ps-3">
                                    <li class="mb-1">
                                        Set an <strong>API Key</strong> in the card above and click
                                        <strong>Save Portal Settings</strong>.
                                    </li>
                                    <li class="mb-1">
                                        Open the interactive API docs:
                                        <a href="/swagger" target="_blank" class="fw-semibold">
                                            /swagger <i class="fa-solid fa-arrow-up-right-from-square fa-xs"></i>
                                        </a>
                                    </li>
                                    <li class="mb-1">
                                        Click the <strong>Authorize 🔒</strong> button (top-right of the Swagger page).
                                        Paste your API key in the <em>Value</em> field — <strong>no</strong>
                                        <code>Bearer&nbsp;</code> prefix, Swagger adds it automatically.
                                        Click <strong>Authorize</strong> then <strong>Close</strong>.
                                    </li>
                                    <li>
                                        Expand any endpoint, click <strong>Try it out</strong>, then
                                        <strong>Execute</strong> to test live responses.
                                    </li>
                                </ol>
                                <div class="text-muted">
                                    <i class="fa-solid fa-terminal fa-xs me-1"></i>
                                    From a shell: <code>curl -H "Authorization: Bearer YOUR_KEY" @(apiBaseUrl)/transfers?limit=10</code>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* LogScale / CrowdStrike Next-Gen SIEM YAML — collapsed by default *@
                    <div class="col-12">
                        <button class="btn btn-sm btn-outline-secondary w-100 text-start d-flex align-items-center justify-content-between"
                                type="button"
                                data-bs-toggle="collapse" data-bs-target="#logscaleSection"
                                aria-expanded="false" aria-controls="logscaleSection">
                            <span>
                                <i class="fa-solid fa-crow me-2"></i>CrowdStrike Next-Gen SIEM / LogScale Collector Config
                            </span>
                            <i class="fa-solid fa-chevron-down small"></i>
                        </button>
                        <div class="collapse mt-2" id="logscaleSection">
                            <div class="d-flex align-items-center justify-content-end mb-1">
                                <button class="btn btn-sm btn-outline-secondary" type="button"
                                        onclick="copyField('logscaleYaml', this)">
                                    <i class="fa-solid fa-copy me-1"></i>Copy YAML
                                </button>
                            </div>
                            @if (!hasApiKey)
                            {
                                <div class="alert alert-warning py-2 mb-2 small">
                                    <i class="fa-solid fa-triangle-exclamation me-1"></i>
                                    Set an API key above and save before using this config — the key placeholder below will not work.
                                </div>
                            }
                            <textarea id="logscaleYaml" class="form-control font-monospace small" rows="18" readonly
                                      style="resize:vertical; background:#f8f9fa;">@logscaleYaml</textarea>
                            <div class="form-text mt-1">
                                Install the <a href="https://library.humio.com/falcon-logscale-collector/log-collector-getting-started.html"
                                               target="_blank" rel="noopener">LogScale Collector</a> on this server, paste the config,
                                then replace <code>YOUR_REPOSITORY</code> with your LogScale repository name.
                                The collector will poll both endpoints every 60 seconds and forward structured JSON events.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-end">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-floppy-disk me-1"></i>Save Portal Settings
                </button>
            </div>
        </form>
    </div>

    @* ══ Tab 5: Branding ══════════════════════════════════════════════════════ *@
    <div class="tab-pane fade @(activeTab == "branding" ? "show active" : "")" id="branding" role="tabpanel">
        <form method="post" asp-page-handler="SaveBranding">
            <div class="card">
                <div class="card-header fw-semibold"><i class="fa-solid fa-pen-nib me-2"></i>Site Identity</div>
                <div class="card-body row g-3">
                    <div class="col-md-6">
                        <label asp-for="Branding.CompanyName" class="form-label">Company / Organisation Name</label>
                        <input asp-for="Branding.CompanyName" class="form-control" placeholder="Network24" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Branding.SiteName" class="form-label">Site Name</label>
                        <input asp-for="Branding.SiteName" class="form-control" placeholder="Main Site" />
                        <div class="form-text">Displayed in the nav-bar and page title.</div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Branding.SupportEmail" class="form-label">Support Email</label>
                        <input asp-for="Branding.SupportEmail" type="email" class="form-control" placeholder="support@example.com" />
                        <span asp-validation-for="Branding.SupportEmail" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Branding.PrimaryColor" class="form-label">Primary Accent Colour</label>
                        <div class="input-group">
                            <input asp-for="Branding.PrimaryColor" type="color" class="form-control form-control-color" style="max-width:3rem;" />
                            <input asp-for="Branding.PrimaryColor" class="form-control font-monospace" placeholder="#0066CC" id="colorHex" />
                        </div>
                        <div class="form-text">Used for nav-bar and badges.</div>
                    </div>
                </div>
                <div class="card-footer text-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-floppy-disk me-1"></i>Save Branding
                    </button>
                </div>
            </div>
        </form>
    </div>

</div>

@section Scripts {
<script>
(function () {
    // ── Restore active tab from TempData (after redirect) ──
    const tabEl = document.querySelector('#settingsTabs a[href="#@activeTab"]');
    if (tabEl) bootstrap.Tab.getOrCreateInstance(tabEl).show();

    // ── Keep tab active on browser back/forward ──
    document.querySelectorAll('#settingsTabs a[data-bs-toggle="tab"]').forEach(el => {
        el.addEventListener('shown.bs.tab', e => history.replaceState(null, '', e.target.getAttribute('href')));
    });

    // ── Show/hide SMB credential fields ──
    const smbCredsToggle = document.getElementById('smbCredsToggle');
    const smbCredFields  = document.getElementById('smbCredFields');
    function toggleSmbCreds() {
        if (smbCredFields) smbCredFields.style.display = smbCredsToggle?.checked ? '' : 'none';
    }
    if (smbCredsToggle) { smbCredsToggle.addEventListener('change', toggleSmbCreds); toggleSmbCreds(); }

    // ── Show/hide archive dir based on checkbox ──
    const archChk = document.getElementById('archAfter');
    const archRow = document.getElementById('archiveDirRow');
    function toggleArchive() { archRow.style.display = archChk.checked ? '' : 'none'; }
    if (archChk) { archChk.addEventListener('change', toggleArchive); toggleArchive(); }

    // ── Show/hide key path and password based on auth method ──
    const keyRow      = document.getElementById('keyPathRow');
    const passwordRow = document.getElementById('passwordRow');
    function applyAuthMethod() {
        const method = document.querySelector('input[name="Ssh.AuthMethod"]:checked')?.value;
        if (keyRow)      keyRow.style.display      = method === 'PublicKey' ? '' : 'none';
        if (passwordRow) passwordRow.style.display = method === 'Password'  ? '' : 'none';
    }
    document.querySelectorAll('input[name="Ssh.AuthMethod"]').forEach(r =>
        r.addEventListener('change', applyAuthMethod));
    applyAuthMethod();

    // ── Show/hide fingerprint row based on strict host key checking ──
    const strictHostChk    = document.getElementById('strictHostChk');
    const fingerprintRow   = document.getElementById('fingerprintRow');
    function applyStrictHostKey() {
        if (fingerprintRow) fingerprintRow.style.display = strictHostChk?.checked ? '' : 'none';
    }
    if (strictHostChk) { strictHostChk.addEventListener('change', applyStrictHostKey); applyStrictHostKey(); }

    // ── Show/hide SSH password ──
    const sshPasswordInput  = document.getElementById('sshPasswordInput');
    const toggleSshPassword = document.getElementById('toggleSshPassword');
    if (toggleSshPassword && sshPasswordInput) {
        toggleSshPassword.addEventListener('click', () => {
            const isText = sshPasswordInput.type === 'text';
            sshPasswordInput.type = isText ? 'password' : 'text';
            toggleSshPassword.querySelector('i').className = isText ? 'fa-solid fa-eye' : 'fa-solid fa-eye-slash';
        });
    }

    // ── Show/hide cert path based on HTTPS toggle ──
    const httpsChk = document.getElementById('enableHttps');
    const certRow = document.getElementById('certPathRow');
    function toggleCert() { certRow.style.display = httpsChk.checked ? '' : 'none'; }
    if (httpsChk) { httpsChk.addEventListener('change', toggleCert); toggleCert(); }

    // ── Entra ID fields show/hide ──
    const entraToggle = document.getElementById('entraToggle');
    const entraFields = document.getElementById('entraFields');
    function toggleEntra() {
        entraFields.style.display = entraToggle.checked ? '' : 'none';
    }
    if (entraToggle) { entraToggle.addEventListener('change', toggleEntra); toggleEntra(); }

    // ── Credential mode — show secret OR managed-identity fields ──
    const secretFields = document.getElementById('secretFields');
    const miFields     = document.getElementById('managedIdentityFields');
    function applyCredMode() {
        const mode = document.querySelector('input[name="Portal.EntraIdCredentialMode"]:checked')?.value;
        if (secretFields) secretFields.style.display = mode === 'ManagedIdentity' ? 'none' : '';
        if (miFields)     miFields.style.display     = mode === 'ManagedIdentity' ? '' : 'none';
    }
    document.querySelectorAll('input[name="Portal.EntraIdCredentialMode"]')
        .forEach(r => r.addEventListener('change', applyCredMode));
    applyCredMode();

    // ── Show/hide client secret ──
    const secretInput = document.querySelector('input[name="Portal.EntraIdClientSecret"]');
    const toggleSecretBtn = document.getElementById('toggleSecret');
    if (toggleSecretBtn && secretInput) {
        toggleSecretBtn.addEventListener('click', () => {
            const isText = secretInput.type === 'text';
            secretInput.type = isText ? 'password' : 'text';
            toggleSecretBtn.querySelector('i').className = isText ? 'fa-solid fa-eye' : 'fa-solid fa-eye-slash';
        });
    }

    // ── Show/hide API key ──
    const apiKeyInput = document.getElementById('apiKeyInput');
    const toggleApiKeyBtn = document.getElementById('toggleApiKey');
    if (toggleApiKeyBtn && apiKeyInput) {
        toggleApiKeyBtn.addEventListener('click', () => {
            const isText = apiKeyInput.type === 'text';
            apiKeyInput.type = isText ? 'password' : 'text';
            toggleApiKeyBtn.querySelector('i').className = isText ? 'fa-solid fa-eye' : 'fa-solid fa-eye-slash';
        });
    }

    // ── Sync colour picker ↔ hex input ──
    const colorPicker = document.querySelector('input[type="color"][name="Branding.PrimaryColor"]');
    const colorHex = document.getElementById('colorHex');
    if (colorPicker && colorHex) {
        colorPicker.addEventListener('input', () => colorHex.value = colorPicker.value);
        colorHex.addEventListener('input', () => {
            if (/^#[0-9a-f]{6}$/i.test(colorHex.value)) colorPicker.value = colorHex.value;
        });
    }
})();

// ── Test Connection (AJAX — uses currently saved config) ──
async function testConnection(btn) {
    const icon    = btn.querySelector('i');
    const origCls = icon ? icon.className : '';
    const origTxt = btn.innerHTML;

    btn.disabled = true;
    if (icon) icon.className = 'fa-solid fa-spinner fa-spin me-1';

    // Remove any previous result badge
    const prev = btn.parentElement.querySelector('.test-result');
    if (prev) prev.remove();

    try {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
        const resp  = await fetch('?handler=TestConnection', {
            method: 'POST',
            headers: { 'RequestVerificationToken': token, 'Content-Type': 'application/x-www-form-urlencoded' },
            body: '__RequestVerificationToken=' + encodeURIComponent(token)
        });
        const data = await resp.json();
        const badge = document.createElement('span');
        badge.className = 'test-result badge ms-2 ' + (data.success ? 'bg-success' : 'bg-danger');
        badge.innerHTML = (data.success ? '<i class="fa-solid fa-check me-1"></i>' : '<i class="fa-solid fa-xmark me-1"></i>') + data.message;
        btn.insertAdjacentElement('afterend', badge);
        setTimeout(() => badge.remove(), 8000);
    } catch (e) {
        const badge = document.createElement('span');
        badge.className = 'test-result badge bg-danger ms-2';
        badge.textContent = 'Request failed: ' + e.message;
        btn.insertAdjacentElement('afterend', badge);
        setTimeout(() => badge.remove(), 8000);
    } finally {
        btn.disabled = false;
        if (icon) icon.className = origCls;
    }
}

// ── Copy-to-clipboard helper (used by integration reference card) ──
function copyField(inputId, btn) {
    const el = document.getElementById(inputId);
    if (!el) return;
    const text = el.tagName === 'TEXTAREA' ? el.value : el.value;
    navigator.clipboard.writeText(text).then(() => {
        const icon = btn.querySelector('i');
        const original = icon ? icon.className : null;
        if (icon) icon.className = 'fa-solid fa-check text-success';
        btn.classList.add('text-success');
        setTimeout(() => {
            if (icon && original) icon.className = original;
            btn.classList.remove('text-success');
        }, 1800);
    }).catch(() => {
        // Fallback for non-HTTPS contexts
        el.select();
        document.execCommand('copy');
    });
}
</script>
