{
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "your-tenant-id",
    "ClientId": "your-client-id",
    "ClientSecret": "your-client-secret",
    "CallbackPath": "/signin-oidc"
  },
  "N24DataRelay": {
    "Branding": {
      "CompanyName": "Network24",
      "ProductName": "N24 Data Relay",
      "SiteName": "Your Site Name",
      "SupportEmail": "support@example.com",
      "LogoPath": "Assets/logo.png",
      "Theme": {
        "PrimaryColor": "#0066CC",
        "SecondaryColor": "#003366",
        "AccentColor": "#FF6600"
      }
    },
    "Paths": {
      "UploadDirectory": "/var/lib/n24-data-relay/uploads",
      "TransferDirectory": "/var/lib/n24-data-relay/uploads/transfer",
      "LogDirectory": "/var/log/n24-data-relay",
      "ConfigDirectory": "/etc/n24-data-relay",
      "TempDirectory": "/var/lib/n24-data-relay/temp"
    },
    "Logging": {
      "RetentionDays": 30,
      "MaxFileSizeMB": 100,
      "EnableEventLog": false,
      "EnableConsole": true
    },
    "Service": {
      "Enabled": true,
      "ServiceName": "n24-data-relay-watcher",
      "DisplayName": "N24 Data Relay Watcher",
      "Description": "Automated file transfer from DMZ to SCADA networks",
      "WatchDirectory": "/var/lib/n24-data-relay/uploads/transfer",
      "TransferMethod": "ssh",
      "RetryAttempts": 3,
      "RetryDelaySeconds": 30,
      "RetryBackoffMultiplier": 2.0,
      "MaxConcurrentTransfers": 5,
      "FileFilter": "*.*",
      "DeleteAfterTransfer": true,
      "ArchiveAfterTransfer": false,
      "ArchiveDirectory": "/var/lib/n24-data-relay/archive",
      "VerifyTransfer": true
    },
    "WebPortal": {
      "Enabled": true,
      "Authentication": {
        "EnableEntraId": false,
        "EnableLocalAccounts": true,
        "ConnectionString": "Data Source=/var/lib/n24-data-relay/n24datarelay.db",
        "RequireEmailConfirmation": false,
        "RequireApproval": true
      },
      "MaxFileSizeBytes": 4294967295,
      "MaxConcurrentUploads": 10,
      "BlockedFileExtensions": [ ".exe", ".dll", ".bat", ".cmd", ".ps1", ".vbs", ".js" ],
      "EnableUploadToTransfer": true,
      "Kestrel": {
        "HttpPort": 8080,
        "HttpsPort": 8443,
        "EnableHttps": false,
        "CertificatePath": null,
        "CertificatePassword": null
      }
    },
    "Transfer": {
      "Ssh": {
        "Host": "",
        "Port": 22,
        "Username": "",
        "AuthMethod": "PublicKey",
        "PrivateKeyPath": "",
        "DestinationPath": "/remote/destination",
        "CreateDestinationDirectory": true,
        "PreserveTimestamps": true,
        "ConnectionTimeout": 30,
        "OperationTimeout": 300
      },
      "Smb": {
        "Server": "",
        "SharePath": "",
        "UseCredentials": false
      }
    }
  }
}
