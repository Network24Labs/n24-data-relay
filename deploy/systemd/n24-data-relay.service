# N24 Data Relay — single service (WebApp + Watcher)
# Copy to /etc/systemd/system/ and adjust paths.
# After install: systemctl daemon-reload && systemctl enable --now n24-data-relay

[Unit]
Description=N24 Data Relay (web upload + file transfer watcher)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
# WorkingDirectory and ExecStart to be set by packaging (e.g. /opt/n24-data-relay and the host executable).
# WorkingDirectory=/opt/n24-data-relay
# ExecStart=/usr/bin/dotnet /opt/n24-data-relay/N24DataRelay.dll
Restart=on-failure
RestartSec=10
# User=n24-data-relay
# Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=0

[Install]
WantedBy=multi-user.target
